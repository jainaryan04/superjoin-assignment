# Copy to .streamlit/secrets.toml for local runs, or paste the contents into
# Streamlit Community Cloud → Manage app → Settings → Secrets.
#
# Must be a TOP-LEVEL key (not under a [section]) so it is also exported as an
# environment variable. The app now reads a [openai] section too, but top-level
# is the safe default.

OPENAI_API_KEY = "sk-..."

# optional
# OPENAI_MODEL = "gpt-4o-mini"
# OPENAI_BASE_URL = "https://api.groq.com/openai/v1"   # or a local Ollama/vLLM endpoint
